<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Jellyfin.Plugin.DinkFlix</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.DinkFlix</RootNamespace>
    <Version>7.0.0.1</Version>
    <AssemblyVersion>7.0.0.1</AssemblyVersion>
    <FileVersion>7.0.0.1</FileVersion>
    <PackageVersion>7.0.0.1</PackageVersion>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration/configPage.html" />
    <EmbeddedResource Include="Web/dinkflix.js" />
  </ItemGroup>
</Project>
